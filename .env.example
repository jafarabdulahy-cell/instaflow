# ───── App ─────────────────────────────────────────────
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=your-super-secret-key-min-32-chars

# ───── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/instaflow

# ───── Meta / Instagram ─────────────────────────────────
# از developers.facebook.com بگیرید
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=your_random_webhook_token
META_OAUTH_SCOPES=instagram_basic,instagram_manage_messages,instagram_manage_comments,pages_show_list,pages_read_engagement,pages_manage_metadata

# ───── Claude AI ────────────────────────────────────────
ANTHROPIC_API_KEY=your_claude_api_key

# ───── Redis (Queue) ────────────────────────────────────
REDIS_URL=redis://localhost:6379
